# ==============================================================
# VibeFree - Environment Variables Configuration
# ==============================================================

# Backend Server Port (Default: 5000)
PORT=5000

# YouTube Data API v3 Key (Optional)
# If left blank, VibeFree automatically operates in High-Fidelity
# Curated Demo Mode with 60+ verified embeddable tracks across Pop,
# Bollywood, Hip-Hop, Lo-Fi, Chill, Workout, and Rock.
#
# To enable live YouTube music searching and trending charts:
# 1. Create a project at https://console.cloud.google.com/
# 2. Enable "YouTube Data API v3" in APIs & Services > Library
# 3. Create an API Key in APIs & Services > Credentials
# 4. Paste the key below:
YOUTUBE_API_KEY=
